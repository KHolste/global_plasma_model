/* style.qss -- Dark theme for Global Plasma Model */

QMainWindow, QWidget {
    background: #0b1020;
    color: #e6edf7;
    font-size: 9pt;
}

/* Header */
QFrame#Header {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #15203b, stop:1 #1f3b73);
    border: 1px solid #2a4b8d;
    border-radius: 6px;
}
QLabel#HeaderTitle {
    font-size: 14pt;
    font-weight: 700;
    color: white;
}
QLabel#HeaderTag {
    background: #1a2744;
    border: 1px solid #3a5080;
    border-radius: 3px;
    padding: 1px 5px;
    color: #8cf0d8;
    font-size: 8pt;
    font-weight: 600;
}

/* GroupBox */
QGroupBox {
    border: 1px solid #24314f;
    border-radius: 6px;
    margin-top: 6px;
    padding-top: 8px;
    background: #0f172a;
    font-weight: 600;
    font-size: 9pt;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 6px;
    padding: 0 3px;
    color: #b0c0e0;
    font-size: 8pt;
}

/* Labels */
QLabel#ParamLabel {
    font-size: 8pt;
    color: #b0bdd0;
}
QLabel#MutedLabel {
    color: #6070a0;
    font-size: 8pt;
}

/* Inputs */
QLineEdit {
    background: #111a31;
    border: 1px solid #2a3d60;
    border-radius: 4px;
    padding: 2px 4px;
    color: white;
    font-size: 9pt;
}
QLineEdit#ReadOnlyField {
    background: #0a1020;
    color: #506080;
    border-color: #1a2840;
}

/* Buttons */
QPushButton {
    background: #17233f;
    border: 1px solid #31466d;
    border-radius: 5px;
    padding: 3px 7px;
    font-weight: 600;
    font-size: 8pt;
}
QPushButton:hover { background: #1e2f56; }
QPushButton[primary="true"] { background: #2553d8; border-color: #4f7eff; }
QPushButton[primary="true"]:hover { background: #2d62fb; }
QPushButton[danger="true"] { background: #7e2431; border-color: #b44b5b; }
QPushButton[danger="true"]:hover { background: #9a2c3c; }

/* Progress */
QProgressBar {
    border: 1px solid #2a3d60;
    border-radius: 4px;
    background: #111a31;
    text-align: center;
    font-size: 7pt;
}
QProgressBar::chunk {
    background: #2dd4bf;
    border-radius: 3px;
}

/* Log */
QTextEdit {
    background: #050812;
    border: 1px solid #1e2e4a;
    border-radius: 4px;
    color: #8ff7c8;
    font-family: Consolas, Menlo, monospace;
    font-size: 8pt;
    padding: 2px;
}

/* Metric Cards */
QFrame#MetricCard {
    background: #111a31;
    border: 1px solid #1e2e4a;
    border-radius: 4px;
    max-height: 42px;
}
QLabel#MetricTitle {
    color: #607898;
    font-size: 7pt;
}
QLabel#MetricValue {
    background: #030712;
    border-radius: 3px;
    padding: 1px 2px;
    color: #7fffd4;
    font-size: 10pt;
    font-weight: 700;
    font-family: Consolas, Menlo, monospace;
}

/* Radio */
QRadioButton {
    spacing: 3px;
    color: #e6edf7;
    font-size: 8pt;
    padding: 1px 2px;
}
QRadioButton::indicator {
    width: 10px; height: 10px;
    border-radius: 5px;
    border: 2px solid #7aa2ff;
    background: #09101f;
}
QRadioButton::indicator:checked { border-color: #2dd4bf; background: #2dd4bf; }
QRadioButton:checked { color: #2dd4bf; font-weight: 700; }

/* ComboBox */
QComboBox {
    background: #111a31;
    border: 1px solid #2a3d60;
    border-radius: 4px;
    padding: 2px 4px;
    color: white;
    font-size: 8pt;
}
QComboBox::drop-down { border: none; width: 14px; }
QComboBox QAbstractItemView {
    background: #111a31;
    border: 1px solid #2a3d60;
    color: white;
    selection-background-color: #2553d8;
}

/* Splitter */
QSplitter::handle { background: #1a2844; width: 3px; height: 3px; }
QSplitter::handle:hover { background: #3a5888; }

/* Status bar */
QStatusBar { font-size: 8pt; color: #6080a0; }
